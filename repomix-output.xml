                  }}
                  className="w-[clamp(3px,0.32vw,4.5px)] h-[clamp(16px,1.8vw,26px)] cursor-pointer rounded-[1px] border-none p-0 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-white/80"
                />
              )
            })}
          </div>
        </div>
      </div>
    </section>
  )
}
