          className={`absolute z-10 rounded-[clamp(10px,1.3vw,16px)] ${cardSurfaceClass}`}
        >
          <CardBorderGlow />
          <div
            style={{
              opacity: isSwapping ? 0 : 1,
              transition: 'opacity 180ms ease',
