  const openCard = (id) => {
    setRevealedExpandedId(null)
    setExpandedCardId(id)
  }

  const closeCard = () => {
    setExpandedCardId(null)
    setRevealedExpandedId(null)
  }

  useEffect(() => {
    const handleResize = () => {
      setIsMobile(window.innerWidth < 640)
    }
    window.addEventListener('resize', handleResize, { passive: true })
    return () => window.removeEventListener('resize', handleResize)
  }, [])

  useEffect(() => {
    let rafId = null
    let lastTime = performance.now()

    const applyVideoStyles = (progress) => {
      const p = easeOutCubic(progress)
      const insetV = (1 - p) * 28
      const insetH = (1 - p) * 18
      const radius = (1 - p) * 24
      const scale = 1 + (1 - p) * 0.1

      if (videoClipRef.current) {
        videoClipRef.current.style.clipPath =
          p >= 0.999
            ? 'none'
            : `inset(${insetV.toFixed(2)}% ${insetH.toFixed(2)}% ${insetV.toFixed(2)}% ${insetH.toFixed(2)}% round ${radius.toFixed(1)}px)`
        videoClipRef.current.style.opacity = (0.5 + 0.5 * p).toFixed(3)
      }
      if (videoRef.current) {
        videoRef.current.style.transform = `scale(${scale.toFixed(4)})`
      }

      if (progress >= 0.62 && !contentRevealedRef.current) {
        contentRevealedRef.current = true
        setIsContentVisible(true)
      } else if (progress < 0.2 && contentRevealedRef.current) {
        contentRevealedRef.current = false
        setIsContentVisible(false)
        setIsVideoFocusMode(false)
        setIsVideoHovered(false)
        setExpandedCardId(null)
        setRevealedExpandedId(null)
      }
    }

    const animateLoop = (now) => {
      const dt = Math.min(0.05, Math.max(0.001, (now - lastTime) / 1000))
      lastTime = now

      const target = targetVideoProgressRef.current
      const current = currentVideoProgressRef.current
      const diff = target - current

      if (Math.abs(diff) > 0.0008) {
        // Frame-rate-independent exponential smoothing directly on DOM refs (zero React re-renders)
        const alpha = 1 - Math.exp(-12 * dt)
        currentVideoProgressRef.current = current + diff * alpha
        applyVideoStyles(currentVideoProgressRef.current)
        rafId = requestAnimationFrame(animateLoop)
      } else {
        currentVideoProgressRef.current = target
        applyVideoStyles(target)
        rafId = null
      }
    }

    const scheduleLoop = () => {
      if (rafId === null) {
        lastTime = performance.now()
        rafId = requestAnimationFrame(animateLoop)
      }
    }

    const computeScrollTarget = () => {
      const vh = window.innerHeight || document.documentElement.clientHeight
      const docHeight = document.documentElement.scrollHeight
      const stageEl = stageRef.current
      if (!stageEl) return

      const rect = stageEl.getBoundingClientRect()
      // Expand the video smoothly as the section enters the viewport so it is
      // already fully open with heading & cards gliding in by the time it settles
      const startY = vh * 0.9
      const endY = vh * 0.12
      const span = Math.max(180, startY - endY)
      let raw = (startY - rect.top) / span

      if (window.scrollY + vh >= docHeight - 6) {
        raw = 1
      }

      const nextTarget = clamp01(raw)
      if (nextTarget !== targetVideoProgressRef.current) {
        targetVideoProgressRef.current = nextTarget
        scheduleLoop()
      }
    }

    // Apply initial visual state synchronously on mount
    computeScrollTarget()
    currentVideoProgressRef.current = targetVideoProgressRef.current
    applyVideoStyles(currentVideoProgressRef.current)

    window.addEventListener('scroll', computeScrollTarget, { passive: true })
    window.addEventListener('resize', computeScrollTarget, { passive: true })

    return () => {
      window.removeEventListener('scroll', computeScrollTarget)
      window.removeEventListener('resize', computeScrollTarget)
      if (rafId !== null) cancelAnimationFrame(rafId)
    }
  }, [])

  // Close expanded card or exit video-only mode on Escape (unless a modal dialog such as WIP is open above it)
  useEffect(() => {
    if (!expandedCardId && !isVideoFocusMode) return
    const handleKeyDown = (e) => {
      if (e.key === 'Escape') {
        if (document.querySelector('[role="dialog"][aria-modal="true"]')) {
          return
        }
        if (expandedCardId) {
          closeCard()
        } else if (isVideoFocusMode) {
