        }
      }
    }
    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  }, [expandedCardId, isVideoFocusMode])

  const canToggleVideoFocus = isContentVisible && !expandedCardId
  const isOverlayVisible = isContentVisible && !isVideoFocusMode

  const handleStageMouseMove = (e) => {
    if (!canToggleVideoFocus) {
      if (isVideoHovered) setIsVideoHovered(false)
      return
    }
    const overInteractive =
      !isVideoFocusMode &&
      e.target instanceof Element &&
      Boolean(e.target.closest('[data-events-overlay="true"]'))

    if (overInteractive) {
      if (isVideoHovered) setIsVideoHovered(false)
      return
    }

    const stageEl = stageRef.current
    const tooltipEl = tooltipRef.current
    if (stageEl && tooltipEl) {
      const rect = stageEl.getBoundingClientRect()
      const tipW = tooltipEl.offsetWidth || 210
      const tipH = tooltipEl.offsetHeight || 34
      const rawX = e.clientX - rect.left + 16
      const rawY = e.clientY - rect.top + 16
      const x = Math.min(Math.max(12, rawX), Math.max(12, rect.width - tipW - 12))
      const y = Math.min(Math.max(12, rawY), Math.max(12, rect.height - tipH - 12))
      tooltipEl.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`
    }
    if (!isVideoHovered) setIsVideoHovered(true)
  }

  const handleStageMouseLeave = () => {
    if (isVideoHovered) setIsVideoHovered(false)
  }

  const handleStageClick = (e) => {
